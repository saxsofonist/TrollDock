+#ifdef _WIN32
+// Shell directory creation is limited to MAX_PATH even in a long-path-aware
+// process. Win32 wide APIs support the UTF-8 job path and long bundle names.
+static bool TrollDockCreateDirectories(const wstring& path)
+{
+	DWORD attributes = ::GetFileAttributesW(path.c_str());
+	if (INVALID_FILE_ATTRIBUTES != attributes) {
+		return 0 != (attributes & FILE_ATTRIBUTE_DIRECTORY);
+	}
+	size_t separator = path.find_last_of(L"\\/");
+	if (wstring::npos == separator || separator == 0) {
+		return false;
+	}
+	if (!TrollDockCreateDirectories(path.substr(0, separator))) {
+		return false;
+	}
+	if (::CreateDirectoryW(path.c_str(), NULL)) {
+		return true;
+	}
+	attributes = ::GetFileAttributesW(path.c_str());
+	return INVALID_FILE_ATTRIBUTES != attributes && 0 != (attributes & FILE_ATTRIBUTE_DIRECTORY);
+}
+#endif
 
