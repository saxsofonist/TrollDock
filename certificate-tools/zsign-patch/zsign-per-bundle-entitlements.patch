+static bool TrollDockIdentifierAllows(const string& strPattern, const string& strIdentifier)
+{
+	size_t star = strPattern.find('*');
+	if (string::npos == star) {
+		return strPattern == strIdentifier;
+	}
+	return star == strPattern.size() - 1 &&
+		0 == strIdentifier.compare(0, star, strPattern, 0, star);
+}
+
+bool ZSignAsset::AllowsBundleId(const string& strBundleId) const
+{
+	size_t dot = m_strApplicationId.find('.');
+	if (strBundleId.empty() || string::npos == dot || 0 == dot) {
+		return false;
+	}
+	string strIdentifier = m_strApplicationId.substr(0, dot + 1) + strBundleId;
+	return TrollDockIdentifierAllows(m_strApplicationId, strIdentifier);
+}
+
+bool ZSignAsset::BuildBundleEntitlements(const string& strBundleId, string& strOutput) const
+{
+	if (!AllowsBundleId(strBundleId)) {
+		ZLog::ErrorV(">>> Provisioning profile does not permit bundle identifier: %s\n", strBundleId.c_str());
+		return false;
+	}
+	jvalue jvEntitlements;
+	if (!jvEntitlements.read_plist(m_strEntitleData) || !jvEntitlements.is_object()) {
+		ZLog::Error(">>> Invalid entitlements property list!\n");
+		return false;
+	}
+	// Do not mutate the shared signing asset. Every nested executable gets its
+	// own XML and DER entitlement blobs from the same resolved dictionary.
+	string strIdentifier = m_strApplicationId.substr(0, m_strApplicationId.find('.') + 1) + strBundleId;
+	jvEntitlements["application-identifier"] = strIdentifier;
+	if (jvEntitlements.has("keychain-access-groups")) {
+		jvalue& groups = jvEntitlements["keychain-access-groups"];
+		if (!groups.is_array()) {
+			ZLog::Error(">>> Invalid keychain access groups!\n");
+			return false;
+		}
+		for (size_t i = 0; i < groups.size(); ++i) {
+			if (!groups[i].is_string()) {
+				ZLog::Error(">>> Invalid keychain access group!\n");
+				return false;
+			}
+			string strGroup = groups[i].as_string();
+			if (string::npos != strGroup.find('*')) {
+				if (!TrollDockIdentifierAllows(strGroup, strIdentifier)) {
+					ZLog::ErrorV(">>> Keychain wildcard does not permit bundle identifier: %s\n", strBundleId.c_str());
+					return false;
+				}
+				groups[i] = strIdentifier;
+			}
+		}
+	}
+	jvEntitlements.style_write_plist(strOutput);
+	return true;
+}
